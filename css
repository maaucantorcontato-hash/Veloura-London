:root {
  --bg: #0b0b0c;
  --surface: #121214;
  --text: #f2f0ec;
  --gold: #c5a265;
  --gold-hover: #e0bc87;
  --font-heading: 'Cormorant Garamond', Georgia, serif;
  --font-body: 'Montserrat', system-ui, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-weight: 300;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; height: auto; display: block; object-fit: cover; }

a { color: inherit; text-decoration: none; transition: color .2s ease; }

.container {
  width: 92%;
  max-width: 1200px;
  margin-inline: auto;
}

label, .label {
  font-family: var(--font-body);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--gold);
}

/* HEADER */
.site-header {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.2rem 4vw;
  background: linear-gradient(to bottom, rgba(11,11,12,0.9), rgba(11,11,12,0));
  transition: background .3s ease;
}

.site-header.scrolled { background: rgba(11,11,12,0.95); backdrop-filter: blur(6px); }

.logo {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 300;
  letter-spacing: 2px;
  color: var(--text);
}
.logo span { color: var(--gold); font-style: italic; }

.nav-menu { display: flex; gap: 2rem; list-style: none; }
.nav-menu a { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; }
.nav-menu a:hover { color: var(--gold); }

.burger { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; }
.burger span { display: block; width: 24px; height: 1px; background: var(--text); transition: .3s; }

/* HERO */
.hero { position: relative; height: 100vh; overflow: hidden; }
.hero-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.55);
}
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(11,11,12,0.3), rgba(11,11,12,0.7));
  z-index: 2;
}
.hero-content {
  position: relative; z-index: 3;
  height: 100%; display: flex; flex-direction: column;
  justify-content: center; align-items: center; text-align: center;
  padding: 0 4vw;
}
.hero-content h1 {
  font-family: var(--font-heading);
  font-size: clamp(3.5rem, 10vw, 8rem);
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: 4px;
  margin: 0.5rem 0 2rem;
}
.hero-content em { font-style: italic; color: var(--gold); }
.hero-content .label { margin-bottom: 0.5rem; }

.btn-gold {
  display: inline-block; padding: 1rem 2.5rem;
  border: 1px solid var(--gold); color: var(--gold);
  font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em;
  transition: background .25s, color .25s;
}
.btn-gold:hover { background: var(--gold); color: var(--bg); }

/* SECTIONS */
.section { padding: 8rem 0; }
.section h2 {
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 300;
  text-align: center;
  margin-bottom: 3rem;
  letter-spacing: 3px;
}

/* GRID */
.grid-3 {
  display: grid; gap: 2rem;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
}
.card img { width: 100%; aspect-ratio: 4/5; object-fit: cover; margin-bottom: 1rem; filter: grayscale(30%) contrast(105%); }
.card h3 { font-family: var(--font-heading); font-weight: 300; font-size: 1.5rem; margin-bottom: 0.5rem; }
.card p { font-size: 0.9rem; opacity: 0.8; }

/* SPLIT */
.split { display: grid; gap: 3rem; align-items: center; grid-template-columns: 1fr 1fr; }
.split img { width: 100%; aspect-ratio: 3/4; object-fit: cover; filter: grayscale(20%); }
.split .texto h2 { text-align: left; margin-bottom: 1.5rem; }
.split .texto p { margin-bottom: 1rem; opacity: 0.9; font-size: 1.05rem; }

.link-gold { color: var(--gold); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid var(--gold); padding-bottom: 2px; }
.link-gold:hover { color: var(--text); border-color: var(--text); }

/* CONTATO */
.contato { text-align: center; }
.contato h2 { margin-bottom: 1rem; }
.contato p { opacity: 0.8; margin-bottom: 1.5rem; }

/* FOOTER */
footer { border-top: 1px solid rgba(255,255,255,0.08); padding: 2.5rem 0; }
.footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
footer .logo { font-size: 1.2rem; }
footer p { font-size: 0.75rem; opacity: 0.6; }

/* RESPONSIVO */
@media (max-width: 900px) {
  .nav-menu {
    position: fixed; inset: 0; background: var(--bg);
    flex-direction: column; align-items: center; justify-content: center; gap: 2.5rem;
    transform: translateX(100%); transition: transform .3s ease;
  }
  .nav-menu.open { transform: translateX(0); }
  .burger { display: flex; }
  .split { grid-template-columns: 1fr; }
}
